ANTHROPIC_API_KEY=

# Neon Postgres connection string, e.g.
# postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# WhatsApp Cloud API (see README "WhatsApp webhook setup")
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional but recommended once the webhook is reachable from the internet —
# without it, incoming webhook calls aren't signature-checked.
WHATSAPP_APP_SECRET=
PORT=3000
